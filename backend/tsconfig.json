{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
"lib": ["ES2020", "dom"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
"moduleResolution": "node16",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,

  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
